# GraphQL endpoint of the Vlaams Termennetwerk API
VITE_GRAPHQL_URL=https://network-of-terms-production-59fup0.laravel.cloud/graphql

# Optional passphrase for the developer simulator page (/nl/simulator).
# Leave empty to show the page without a gate (it then shows a test/demo-only banner).
VITE_SIMULATOR_KEY=

# Public project key of the Black Badge Studio feedback widget (app.blackbadge.studio).
# Leave empty to run without the floating feedback button. The server only accepts
# origins registered on the project, so the key itself is not secret.
VITE_FEEDBACK_WIDGET_KEY=
# Optional: override the widget script URL (defaults to https://app.blackbadge.studio/feedback-widget.js).
#VITE_FEEDBACK_WIDGET_SCRIPT=
